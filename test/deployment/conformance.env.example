# Public, deployment-neutral target contract. Values must not include embedded credentials.
ADENOSINE_CONFORMANCE_BASE_URL=https://forge.example.com
ADENOSINE_CONFORMANCE_RELEASE=0.1.0
ADENOSINE_CONFORMANCE_OWNER=alice.example.com
ADENOSINE_CONFORMANCE_REPOSITORY=deployment-conformance
ADENOSINE_CONFORMANCE_TARGET=custom
# Comma-separated declarations: health,docs,openapi,git-http,web,build-identity,ssh,telemetry,backup-restore.
ADENOSINE_CONFORMANCE_CAPABILITIES=health,docs,openapi,git-http,web
ADENOSINE_CONFORMANCE_IMAGE_DIGEST=

# PAT must have repository:write access to the existing public test repository.
ADENOSINE_CONFORMANCE_PAT=

# Optional SSH capability. All three values are required when SSH is enabled.
ADENOSINE_CONFORMANCE_SSH_HOST=
ADENOSINE_CONFORMANCE_SSH_PORT=2222
ADENOSINE_CONFORMANCE_SSH_KEY=
ADENOSINE_CONFORMANCE_SSH_KNOWN_HOSTS=

# Optional operator hooks. Commands receive the exported variables above and BACKUP_ID.
ADENOSINE_CONFORMANCE_BACKUP_COMMAND=
ADENOSINE_CONFORMANCE_RESTORE_COMMAND=
ADENOSINE_CONFORMANCE_TELEMETRY_COMMAND=
