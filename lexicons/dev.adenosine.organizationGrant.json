{
  "lexicon": 1,
  "id": "dev.adenosine.organizationGrant",
  "defs": {
    "main": {
      "type": "record",
      "description": "An organization owner grants an invitee a member or owner role.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["organization", "subject", "role", "authority", "createdAt"],
        "properties": {
          "organization": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "subject": { "type": "string", "format": "did" },
          "role": { "type": "string", "knownValues": ["owner", "member"], "maxLength": 16 },
          "authority": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" },
          "expiresAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
