{
  "lexicon": 1,
  "id": "dev.adenosine.issueStatus",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["subject", "repository", "state", "createdAt", "updatedAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "repository": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "state": {
            "type": "string",
            "knownValues": ["open", "closed"]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
