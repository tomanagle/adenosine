{
  "lexicon": 1,
  "id": "dev.adenosine.organization",
  "defs": {
    "main": {
      "type": "record",
      "description": "Stable public profile and root authority for an Adenosine organization.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["slug", "name", "createdAt", "updatedAt"],
        "properties": {
          "slug": { "type": "string", "maxLength": 100, "maxGraphemes": 100 },
          "name": { "type": "string", "maxLength": 255, "maxGraphemes": 100 },
          "description": { "type": "string", "maxLength": 2000, "maxGraphemes": 2000 },
          "website": { "type": "string", "format": "uri", "maxLength": 2048 },
          "location": { "type": "string", "maxLength": 255, "maxGraphemes": 100 },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
