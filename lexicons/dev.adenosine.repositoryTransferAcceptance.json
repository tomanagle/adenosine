{
  "lexicon": 1,
  "id": "dev.adenosine.repositoryTransferAcceptance",
  "defs": {
    "main": {
      "type": "record",
      "description": "A destination owner accepts a transfer proposal and identifies its successor repository record.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["proposal", "repository", "createdAt"],
        "properties": {
          "proposal": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "repository": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
