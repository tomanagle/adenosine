{
  "lexicon": 1,
  "id": "dev.adenosine.subjectTriage",
  "defs": {
    "main": {
      "type": "record",
      "description": "The complete repository-authoritative labels, assignees, and milestone for one issue or pull request.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "kind",
          "repository",
          "labels",
          "assignees",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "kind": { "type": "string", "knownValues": ["issue", "pull_request"] },
          "repository": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "labels": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "format": "at-uri" }
          },
          "assignees": {
            "type": "array",
            "maxLength": 10,
            "items": { "type": "string", "format": "did" }
          },
          "milestone": { "type": "string", "format": "at-uri" },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
