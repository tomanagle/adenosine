{
  "lexicon": 1,
  "id": "dev.adenosine.pullRequest",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["sourceRepository", "targetRepository", "sourceBranch", "targetBranch", "headSHA", "title", "body", "createdAt", "updatedAt"],
        "properties": {
          "sourceRepository": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The dev.adenosine.repo record containing the proposed commits."
          },
          "targetRepository": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The dev.adenosine.repo record receiving the proposed commits."
          },
          "sourceBranch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "targetBranch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "headSHA": {
            "type": "string",
            "minLength": 40,
            "maxLength": 64,
            "description": "A lowercase hexadecimal Git SHA-1 or SHA-256 object ID."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "body": {
            "type": "string",
            "maxLength": 65535
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
