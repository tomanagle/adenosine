# Copy with scripts/bootstrap.sh. Values marked GENERATED are replaced once and preserved.
ADENOSINE_DOMAIN=code.example.com
ADENOSINE_BASE_URL=https://code.example.com
ADENOSINE_SSH_HOST=code.example.com
ADENOSINE_SSH_PORT=22
ADENOSINE_HTTP_PORT=80
ADENOSINE_HTTPS_PORT=443
ADENOSINE_IMAGE=ghcr.io/tomanagle/adenosine
ADENOSINE_VERSION=v0.1.0
# Override only for isolated CI/restore drills; production uses the fixed project name.
ADENOSINE_COMPOSE_PROJECT=adenosine-production
POSTGRES_USER=adenosine
POSTGRES_DB=adenosine
POSTGRES_PASSWORD=GENERATED
ADENOSINE_OAUTH_STATE_KEY=GENERATED
ADENOSINE_OAUTH_CREDENTIAL_KEY=GENERATED
TAP_ADMIN_PASSWORD=GENERATED
ELECTRIC_DATABASE_PASSWORD=GENERATED
ELECTRIC_SECRET=GENERATED
# Optional profiles require both starting the profile and setting these application values.
COMPOSE_PROFILES=
ADENOSINE_TAP_CONSUMER=
ADENOSINE_ELECTRIC_URL=
ADENOSINE_ELECTRIC_SECRET=
OTEL_TRACES_SAMPLER_ARG=0.10
