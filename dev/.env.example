# `make dev` generates .env.local at the repository root. These names form the
# supported local configuration contract; secret values are generated there.
POSTGRES_USER=adenosine
POSTGRES_DB=adenosine
POSTGRES_PASSWORD=generated-by-make-dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://adenosine:generated-by-make-dev@postgres:5432/adenosine?sslmode=disable
ADENOSINE_BASE_URL=http://127.0.0.1:8080
ADENOSINE_LISTEN_ADDR=:8080
ADENOSINE_REPO_ROOT=/var/lib/adenosine/repos
ADENOSINE_RELEASE_ASSET_BACKEND=filesystem
ADENOSINE_RELEASE_ASSET_ROOT=/var/lib/adenosine/state/release-assets
ADENOSINE_REPOSITORY_DELETION_RETENTION=168h
ADENOSINE_GIT_BINARY=git
ADENOSINE_HTTP_PORT=8080
ADENOSINE_SSH_LISTEN_ADDR=:2222
ADENOSINE_SSH_HOST=localhost
ADENOSINE_SSH_PORT=2222
ADENOSINE_SSH_HOST_KEY_PATH=/var/lib/adenosine/state/ssh_host_ed25519_key
ADENOSINE_OAUTH_STATE_KEY=generated-by-make-dev
ADENOSINE_OAUTH_CREDENTIAL_KEY=generated-by-make-dev
ADENOSINE_TAP_CONSUMER=tap:dev.adenosine:v1
ADENOSINE_TAP_ADMIN_PASSWORD=generated-by-make-dev
TAP_ADMIN_PASSWORD=generated-by-make-dev
GRAFANA_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
