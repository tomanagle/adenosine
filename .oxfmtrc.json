{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "packages/api-client/src/generated/**",
    "web/src/routeTree.gen.ts",
    "**/.tanstack/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/.nitro/**",
    "**/.output/**",
    "**/dist/**",
    "**/coverage/**",
    "coverage.out",
    "bin/**"
  ]
}
